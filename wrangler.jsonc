{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "music-matcher",
  "compatibility_date": "2026-10-28",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "matchmymusic.app",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
